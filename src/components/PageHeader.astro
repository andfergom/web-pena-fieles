---
interface Props { title: string; intro?: string }
const { title, intro } = Astro.props;
---
<section class="bg-verde text-white">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <h1 class="text-4xl md:text-5xl text-white">{title}</h1>
    {intro && <p class="mt-3 max-w-2xl text-lg text-white/85">{intro}</p>}
  </div>
</section>
