---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <img src="/escudo.svg" alt="" width="140" height="140" class="mx-auto w-36" />
    <h1 class="mt-6 text-4xl">Balón fuera</h1>
    <p class="mt-3 text-lg">La página que buscas no existe o se ha movido.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-verde px-6 py-3 font-semibold text-white no-underline hover:bg-verde-oscuro hover:text-white">Volver al inicio</a>
  </section>
</Base>
